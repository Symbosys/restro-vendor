// Notification System (Updated for broadcast-based order flow)
enum NotificationType {
  NEW_ORDER
  ORDER_STATUS_UPDATE
  ORDER_DELIVERED
  ORDER_CANCELLED
  PROMOTION
  NEW_MENU_ITEM
  VENDOR_MESSAGE
  USER_MESSAGE
  DELIVERY_ASSIGNMENT // For delivery partner acceptance confirmation
  VENDOR_ORDER_REQUEST // Broadcast to vendors for order pickup (with accept/reject CTA)
  DELIVERY_ORDER_REQUEST // Broadcast to delivery partners (with accept/reject CTA)
  ORDER_REJECTED // Auto-sent to non-winners after assignment (e.g., "Order assigned to another")
  PAYMENT_RECEIVED
  PAYOUT_PROCESSED
  ACCOUNT_ALERT
  SYSTEM
}

enum RecipientType {
  USER
  VENDOR
  DELIVERY_PARTNER
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
  SMS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        BigInt  @id @default(autoincrement())
  // Separate optional relations (only one will be populated per notification)
  userId    BigInt? // For USER notifications
  vendorId  BigInt? // For VENDOR notifications
  partnerId BigInt? // For DELIVERY_PARTNER notifications

  // Retain type for logic/filtering (e.g., ensure only one ID is set)
  recipientType RecipientType // USER | VENDOR | DELIVERY_PARTNER (enforced in app)

  title     String
  body      String
  type      NotificationType     @default(VENDOR_ORDER_REQUEST)
  data      Json? // Flexible payload: { orderId: 123, broadcastId: 456, deepLink: "/order/123", action: 'accept' | 'reject' }
  deepLink  String?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  sentAt    DateTime             @default(now())
  expiresAt DateTime? // TTL for ephemeral notifications (e.g., 2min for broadcast requests)
  channel   NotificationChannel  @default(PUSH) // PUSH | EMAIL | IN_APP | SMS
  priority  NotificationPriority @default(NORMAL) // For sorting/urgent handling

  // Optional link to order for relational queries (e.g., "all notifications for my orders")
  orderId BigInt? // Denormalized for performance; set for order-related types

  // Explicit relations (Prisma can now join via .include)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  deliveryPartner DeliveryPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints (app-enforced: exactly one of userId/vendorId/partnerId is non-null)

  // Indexes (adjusted for separate IDs + new orderId)
  @@index([userId])
  @@index([vendorId])
  @@index([partnerId])
  @@index([orderId]) // For order-linked fetches
  @@index([recipientType])
  @@index([isRead, sentAt]) // For unread/latest fetches
  @@index([type, priority]) // For type-based filtering
  @@index([expiresAt]) // For cleanup jobs
  @@map("notifications")
}

// Note: For broadcasts, on creating OrderVendorBroadcast/OrderDeliveryBroadcast entries, bulk-insert Notifications with type VENDOR_ORDER_REQUEST/DELIVERY_ORDER_REQUEST, data: { orderId, broadcastId, distance: 4.2, eta: 15 }, expiresAt: now() + 2min. On accept, create ORDER_STATUS_UPDATE for user/vendor/partner. On reject/assignment, create ORDER_REJECTED for non-winners.

// ======================================================
// 💳 Centralized Review db model 
// ======================================================
enum ReviewAspect {
  OVERALL
  FOOD_QUALITY
  PACKAGING
  DELIVERY_SPEED
  DELIVERY_COURTESY
  VENDOR_SERVICE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REPORTED
}

enum ReviewTarget {
  VENDOR
  DELIVERY_PARTNER
  BOTH
}

enum ReviewSource {
  USER
  ADMIN
  SYSTEM
}

model CentralizedReview {
  id BigInt @id @default(autoincrement())

  // Core relations
  orderId BigInt? @unique
  userId  BigInt

  target ReviewTarget @default(BOTH)

  // Vendor-specific
  vendorId                BigInt?
  vendorOverallRating     Int?
  vendorFoodQualityRating Int?
  vendorPackagingRating   Int?
  vendorServiceRating     Int?

  // Delivery-specific
  deliveryPartnerId      BigInt?
  deliveryOverallRating  Int?
  deliverySpeedRating    Int?
  deliveryCourtesyRating Int?

  // Unified content
  reviewText    String?
  images        Json?
  ratingAverage Decimal? @db.Decimal(3, 2)

  // Moderation & engagement
  isHelpful        Boolean      @default(false)
  helpfulVotes     Int          @default(0)
  helpfulDownVotes Int          @default(0)
  isReported       Boolean      @default(false)
  reportReason     String?
  status           ReviewStatus @default(PENDING)
  rejectReason     String?
  source           ReviewSource @default(USER)

  // Reply support (future)
  replyText String?
  replyAt   DateTime?

  // Relations
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user            User             @relation(fields: [userId], references: [id])
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, target]) // ensures one review per order per target
  // Indexes
  @@index([userId])
  @@index([vendorId])
  @@index([deliveryPartnerId])
  @@index([vendorId, createdAt])
  @@index([deliveryPartnerId, createdAt])
  @@index([target])
  @@index([status])
  @@index([isHelpful, helpfulVotes])
  @@index([createdAt])
  @@map("centralized_reviews")
}

// ======================================================
// 💳 Centralized Payment Model (Scalable, Extensible)
// ======================================================

enum PaymentEntityType {
  ORDER
  ELITE_MEMBERSHIP
  WALLET_TOPUP
  WALLET_REFUND
  VENDOR_PAYOUT
  DELIVERY_PAYOUT
  REFERRAL_REWARD
  SUBSCRIPTION
  OTHER
}

enum PaymentDirection {
  INCOMING // From user to platform (orders, memberships)
  OUTGOING // From platform to vendor/partner/user (payouts, refunds)
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  CASHFREE
  PHONEPE
  INTERNAL_WALLET
  MANUAL
  OTHER
}

model Payment {
  id BigInt @id @default(autoincrement())

  // 🔗 Entity linkage
  entityType PaymentEntityType
  entityId   BigInt? // ID of the linked entity (e.g., Order.id, Membership.id)
  orderId    BigInt?           @unique
  userId     BigInt? // For user payments (inbound or refund)
  vendorId   BigInt? // For vendor payouts
  partnerId  BigInt? // For delivery partner payouts

  // 💰 Financial details
  direction        PaymentDirection @default(INCOMING)
  amount           Decimal          @db.Decimal(10, 2)
  currency         String           @default("INR")
  method           PaymentMethod    @default(UPI)
  gateway          PaymentGateway   @default(PHONEPE)
  gatewayOrderId   String? // Razorpay order_id / Stripe session_id
  gatewayPaymentId String? // Razorpay payment_id / Stripe txn_id
  referenceId      String? // Internal or external reference (for reconciliation)
  description      String?
  metadata         Json? // Flexible extra data (e.g., {planId: 3, autoRenew: true})

  // 🔄 Lifecycle
  status          PaymentStatus @default(PENDING)
  initiatedAt     DateTime      @default(now())
  authorizedAt    DateTime?
  capturedAt      DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  refundReference String?

  // 🧩 Relations (all optional to keep it generic)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  deliveryPartner DeliveryPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // 🕒 Timestamps
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  userEliteMemberships UserEliteMembership[]

  // 📊 Indexes for performance
  @@index([entityType, entityId])
  @@index([userId])
  @@index([vendorId])
  @@index([partnerId])
  @@index([status])
  @@index([method])
  @@index([gateway])
  @@index([createdAt])
  @@map("payments")
}

// ======================================================
// 🎫 Centralized Support Ticket System (Scalable Issue Reporting)
// ======================================================

enum TicketCategory {
  ORDER_ISSUE // Problems with orders (wrong item, missing item, etc.)
  PAYMENT_ISSUE // Payment failures, refund requests
  DELIVERY_ISSUE // Late delivery, delivery partner behavior
  ACCOUNT_ISSUE // Account access, profile updates
  TECHNICAL_ISSUE // App bugs, crashes
  FEEDBACK // General feedback/suggestions
  COMPLAINT // Formal complaints
  INQUIRY // General inquiries
  BUG // App bugs, crashes
  OTHER // Miscellaneous
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN // Newly created ticket
  IN_PROGRESS // Being worked on by support
  AWAITING_RESPONSE // Waiting for reporter's response
  RESOLVED // Issue resolved
  CLOSED // Ticket closed (after resolution confirmation)
  REOPENED // Reopened after being resolved/closed
  ESCALATED // Escalated to higher authority
}

enum TicketReporterType {
  USER
  VENDOR
  DELIVERY_PARTNER
}

model SupportTicket {
  id           BigInt @id @default(autoincrement())
  ticketNumber String @unique // e.g., "TKT-2026-000001"

  // 🔗 Reporter relations (only one will be populated based on reporterType)
  reporterType TicketReporterType
  userId       BigInt? // For USER tickets
  vendorId     BigInt? // For VENDOR tickets
  partnerId    BigInt? // For DELIVERY_PARTNER tickets

  // 🔗 Optional order relation (if issue is order-related)
  orderId BigInt?

  // 📋 Ticket details
  category    TicketCategory @default(OTHER)
  subject     String         @db.VarChar(255)
  description String         @db.Text
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  // 📎 Attachments (images, screenshots, etc.)
  attachments Json? // Array of { url, type, name, size }

  // 👤 Admin/Support assignment
  assignedTo BigInt? // Admin ID who is handling this ticket

  // 💬 Resolution details
  resolution String?   @db.Text
  resolvedAt DateTime?
  resolvedBy BigInt? // Admin ID who resolved

  // 📊 Metadata
  source   String? @default("APP") // APP, WEB, EMAIL, PHONE
  metadata Json? // Flexible extra data (device info, app version, etc.)

  // 🔄 Reopening tracking
  reopenCount    Int       @default(0)
  lastReopenedAt DateTime?

  // ⭐ Feedback after resolution
  feedbackRating  Int? // 1-5 rating
  feedbackComment String?

  // 🕒 Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  // 🔗 Relations
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  deliveryPartner DeliveryPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // 💬 Ticket messages thread
  messages SupportTicketMessage[]

  // 📊 Indexes
  @@index([ticketNumber])
  @@index([userId])
  @@index([vendorId])
  @@index([partnerId])
  @@index([orderId])
  @@index([reporterType])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([status, priority])
  @@index([reporterType, status])
  @@map("support_tickets")
}

// 💬 Support Ticket Message Thread
model SupportTicketMessage {
  id       BigInt @id @default(autoincrement())
  ticketId BigInt

  // 🔗 Sender info
  senderType   TicketReporterType // Who sent this message
  senderId     BigInt? // User/Vendor/Partner/Admin ID
  isAdminReply Boolean            @default(false)

  // 📝 Message content
  message     String @db.Text
  attachments Json? // Array of { url, type, name, size }

  // ✅ Read status
  isRead Boolean   @default(false)
  readAt DateTime?

  // 🕒 Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔗 Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // 📊 Indexes
  @@index([ticketId])
  @@index([senderType])
  @@index([createdAt])
  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}
