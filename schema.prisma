// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUB_ADMIN
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Admin {
  id       BigInt @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model City {
  id      BigInt  @id @default(autoincrement())
  name    String
  state   String?
  country String  @default("India")

  latitude  Float?
  longitude Float?

  isActive Boolean @default(true)
  isHiring Boolean @default(true)

  areas Area[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([isActive])
}

model Area {
  id     BigInt @id @default(autoincrement())
  cityId BigInt
  city   City   @relation(fields: [cityId], references: [id])

  name String

  latitude  Float
  longitude Float

  serviceRadiusKm Float @default(5.0)

  isActive Boolean @default(true)
  isHiring Boolean @default(true)

  priority Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([cityId, name])
  @@index([cityId])
  @@index([latitude, longitude])
  @@index([isActive, isHiring])
}

model User {
  id        BigInt  @id @default(autoincrement())
  name      String
  mobile    String  @unique
  email     String? @unique
  longitude Float?
  latitude  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  carts     Cart[]

  fcmToken             String[]
  UserWallet           UserWallet?
  Notification         Notification[]
  CentralizedReview    CentralizedReview[]
  Order                Order[]
  payments             Payment[]
  userEliteMemberships UserEliteMembership[]
  supportTickets       SupportTicket[]

  @@index([mobile])
  @@map("users")
}

// =====================================
// 🏆 Elite Membership System (Final Simplified Version)
// =====================================

enum EliteMembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
  REFUNDED
}

// ✅ Only one plan will exist — but schema still supports future updates if needed.
model ElitePlan {
  id           BigInt  @id @default(autoincrement())
  name         String  @default("Elite Membership")
  description  String? @default("Enjoy free delivery and exclusive benefits with Elite Membership.")
  durationDays Int     @default(30) // 1-month duration
  price        Decimal @default(0.00) @db.Decimal(10, 2)
  currency     String  @default("INR")
  isActive     Boolean @default(true)
  isTrial      Boolean @default(false) // Will be true for free trial

  // Fixed set of benefits (can evolve later)
  benefits Json? @default("{\"freeDelivery\":true,\"prioritySupport\":true}")

  // Relations
  memberships UserEliteMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("elite_plans")
}

// ✅ Tracks each user's active or expired elite membership
model UserEliteMembership {
  id     BigInt                @id @default(autoincrement())
  userId BigInt
  planId BigInt
  status EliteMembershipStatus @default(ACTIVE)

  startDate DateTime @default(now())
  endDate   DateTime
  isTrial   Boolean  @default(true)
  autoRenew Boolean  @default(false)

  // ✅ Centralized Payment Link
  paymentId BigInt?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  totalPaid Decimal @default(0.00) @db.Decimal(10, 2)

  // Relations
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan ElitePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, status], name: "user_active_elite_unique")
  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("user_elite_memberships")
}

model UserWallet {
  id       BigInt  @id @default(autoincrement())
  userId   BigInt  @unique
  balance  Decimal @default(0) @db.Decimal(10, 2)
  currency String  @default("INR")
  isLocked Boolean @default(false)

  transactions UserWalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallets")
}

model UserWalletTransaction {
  id          BigInt            @id @default(autoincrement())
  walletId    BigInt
  amount      Decimal           @db.Decimal(10, 2)
  type        TransactionType   @default(DEBIT)
  status      TransactionStatus @default(PENDING)
  description String?
  referenceId String? // e.g., Razorpay TXN ID
  orderId     BigInt?
  initiatedBy String? // "SYSTEM" | "USER"

  wallet UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order?     @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([type, status])
  @@map("user_wallet_transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model Address {
  id              BigInt      @id @default(autoincrement())
  userId          BigInt
  type            AddressType @default(HOME)
  mainAddress     String
  completeAddress String

  receiverName    String
  receiverContact String
  landMark        String?
  floor           String?
  city            String?
  instructions    String?

  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)
  isDeleted Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order[]

  @@map("addresses")
}

model Otp {
  id              BigInt    @id @default(autoincrement())
  mobile          String    @unique
  otp             String
  expiresAt       DateTime
  attempts        Int       @default(0)
  lastAttemptedAt DateTime?
  isUsed          Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mobile])
  @@map("otps")
}

model Category {
  id          BigInt  @id @default(autoincrement())
  name        String
  image       Json
  description String?

  subCategories SubCategory[]
  products      Product[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vendorCategories VendorCategory[]

  @@map("categories")
}

model SubCategory {
  id          BigInt  @id @default(autoincrement())
  name        String
  image       Json
  description String?
  categoryId  BigInt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sub_categories")
}

model Product {
  id           BigInt   @id @default(autoincrement())
  name         String
  description  String?
  marketPrice  Decimal? @db.Decimal(10, 2)
  sellingPrice Decimal  @db.Decimal(10, 2)
  vendorPrice  Decimal? @db.Decimal(10, 2)
  weight       String
  pieces       String
  isActive     Boolean  @default(true)
  isMandatory  Boolean  @default(false)

  categoryId    BigInt
  subCategoryId BigInt?
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  images    ProductImage[]
  cartItems CartItem[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  VendorProduct VendorProduct[]
  OrderItem     OrderItem[]

  @@map("products")
}

model ProductImage {
  id        BigInt @id @default(autoincrement())
  image     Json
  productId BigInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

model Cart {
  id     BigInt @id @default(autoincrement())
  userId BigInt

  total Decimal? @default(0.00) @db.Decimal(10, 2)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        BigInt  @id @default(autoincrement())
  cartId    BigInt
  productId BigInt
  quantity  Int     @default(1)
  notes     String?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

/**
 * Order DB model starts from here
 */

// Enums for Order System (Refined for broadcast-based assignment)
enum OrderStatus {
  PLACED // User placed the order, payment captured/pending
  VENDOR_PENDING // Notifying vendors in 5km radius of user
  VENDOR_ACCEPTED // First vendor accepted, assigned
  PREPARING // Vendor preparing items
  READY_FOR_PICKUP // Items ready at vendor
  DELIVERY_PENDING // Notifying delivery partners in 5km of assigned vendor
  OUT_FOR_DELIVERY // First delivery partner accepted, en route
  DELIVERED // Successfully delivered
  CANCELLED // Cancelled by user/vendor/system before delivery
  REFUNDED // Full refund processed post-cancel/dispute
  DISPUTED // Issue raised (e.g., wrong item)
}

enum PaymentMethod {
  WALLET // Deduct from UserWallet
  UPI // Razorpay UPI
  CARD // Credit/Debit Card
  NETBANKING // Internet Banking
  COD // Cash on Delivery
  RAZORPAY // Generic external gateway
  PHONEPE // Generic external gateway
}

enum PaymentStatus {
  PENDING // Order placed, payment initiated
  AUTHORIZED // Payment captured but not settled (e.g., for COD)
  PAID // Fully paid upfront
  FAILED // Payment declined
  REFUNDED // Full refund
}

enum DeliveryStatus {
  NOT_ASSIGNED // Pending assignment
  ASSIGNED // Assigned to partner
  PICKED_UP // Partner at vendor
  IN_TRANSIT // En route to customer
  DELIVERED // Handed over
  FAILED // Delivery failed (e.g., no-show)
}

enum RefundReason {
  USER_CANCELLED
  VENDOR_UNAVAILABLE
  OUT_OF_STOCK
  WRONG_ITEM
  DAMAGED
  LATE_DELIVERY
  SYSTEM_ERROR
  VENDOR_REJECTED // All vendors rejected/no acceptance
  DELIVERY_FAILED // No delivery partner accepted
}

enum OrderSource {
  APP // Mobile/Web app
  WEBSITE // Web
  TELEPHONE // Call center (rare)
}

enum OrderEventType {
  ORDER_PLACED
  VENDOR_NOTIFIED
  VENDOR_ACCEPTED
  VENDOR_REJECTED
  PREPARING_STARTED
  READY_FOR_PICKUP
  DELIVERY_NOTIFIED
  DELIVERY_ACCEPTED
  DELIVERY_REJECTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  DISPUTE_RAISED
}

model Order {
  id          BigInt @id @default(autoincrement())
  orderNumber String @unique // e.g., "ORD-2025-001" generated
  userId      BigInt
  addressId   BigInt // Delivery address

  // 💰 Financials
  itemTotal      Decimal @db.Decimal(10, 2)
  gstOnItemTotal Decimal @default(0) @db.Decimal(10, 2)

  deliveryFee Decimal @default(0) @db.Decimal(10, 2)

  platformFee   Decimal @default(0) @db.Decimal(10, 2)
  gstOnPlatform Decimal @default(0) @db.Decimal(10, 2)

  packingFee      Decimal @default(0) @db.Decimal(10, 2)
  gstOnPackingFee Decimal @default(0) @db.Decimal(10, 2)

  tipAmount Decimal? @default(0) @db.Decimal(10, 2)

  surcharge Decimal? @default(0) @db.Decimal(10, 2)

  // taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal? @default(0) @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  currency       String   @default("INR")

  // ⚙️ Status & Lifecycle
  status         OrderStatus    @default(PLACED)
  paymentStatus  PaymentStatus  @default(PENDING)
  deliveryStatus DeliveryStatus @default(NOT_ASSIGNED)

  // 🧾 Metadata
  notes            String?
  source           OrderSource   @default(APP)
  paymentMethod    PaymentMethod @default(UPI)
  // paymentGateway   PaymentGateway @default(PHONEPE)
  paymentReference String?
  refundReference  String?
  cancelReason     String?
  disputeDetails   Json?

  // 🔗 Relations
  reviewId BigInt?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address  Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  // 🧩 Linked Models
  items                   OrderItem[]
  refunds                 OrderRefund?
  tracking                OrderTrackingEvent[]
  vendorBroadcasts        OrderVendorBroadcast[]
  deliveryBroadcasts      OrderDeliveryBroadcast[]
  orderDeliveryAssignment OrderDeliveryAssignment?
  notifications           Notification[]
  review                  CentralizedReview?

  // 💸 Wallet Transactions (still denormalized here)
  userWalletDebitId             BigInt?
  vendorWalletCreditId          BigInt?
  deliveryPartnerWalletCreditId BigInt?

  // 🕒 Timestamp relationship
  timestamps                       OrderTimestamps?
  VendorWalletTransaction          VendorWalletTransaction[]
  DeliveryPartnerWalletTransaction DeliveryPartnerWalletTransaction[]
  UserWalletTransaction            UserWalletTransaction[]
  orderVendorAssignments           OrderVendorAssignment?
  payments                         Payment?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supportTickets SupportTicket[]

  // 📊 Indexes
  @@index([userId])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([orderNumber])
  @@index([userId, status])
  @@index([status])
  @@map("orders")
}

model OrderTimestamps {
  id      BigInt @id @default(autoincrement())
  orderId BigInt @unique

  // 📆 Timeline Fields
  placedAt           DateTime  @default(now())
  vendorNotifiedAt   DateTime?
  vendorAssignedAt   DateTime?
  confirmedAt        DateTime?
  readyAt            DateTime?
  deliveryNotifiedAt DateTime?
  deliveryAssignedAt DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?

  // 🔗 Relation
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_timestamps")
}

// Order Items (Line Items - Snapshot product; vendorProductId set post-assignment)
model OrderItem {
  id              BigInt         @id @default(autoincrement())
  orderId         BigInt
  productId       BigInt // References global Product
  vendorProductId BigInt? // Set post-vendor assignment (price snapshot from assigned vendor)
  quantity        Int
  unitPrice       Decimal        @db.Decimal(10, 2) // Base price at order (updated post-assignment if needed)
  totalPrice      Decimal        @db.Decimal(10, 2) // quantity * unitPrice
  notes           String? // Item-specific notes (e.g., "cut into pieces")
  // Relations
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  vendorProduct   VendorProduct? @relation(fields: [vendorProductId], references: [id])

  // Indexes
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Full Refunds Only (No partials/items)
model OrderRefund {
  id          BigInt        @id @default(autoincrement())
  orderId     BigInt        @unique // One refund per order (full)
  amount      Decimal       @db.Decimal(10, 2) // Full totalAmount
  reason      RefundReason?
  status      PaymentStatus @default(PENDING)
  referenceId String? // Gateway refund ID
  processedAt DateTime?
  description String? // e.g., "Full refund due to cancellation"
  // Relations
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([orderId])
  @@index([status])
  @@index([reason])
  @@map("order_refunds")
}

// Order Tracking Events (Audit trail for statuses, locations, assignments)
model OrderTrackingEvent {
  id         BigInt         @id @default(autoincrement())
  orderId    BigInt
  eventType  OrderEventType @default(ORDER_PLACED)
  latitude   Float? // GPS snapshot (e.g., for pickup/delivery)
  longitude  Float?
  location   String? // Address snapshot
  eta        Int? // Minutes remaining
  notes      String? // e.g., "Vendor accepted", "Delayed due to traffic"
  executedBy String? // "USER" | "VENDOR:<id>" | "PARTNER:<id>" | "SYSTEM"
  timestamp  DateTime       @default(now())
  // Relations
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([orderId])
  @@index([eventType])
  @@index([timestamp])
  @@index([orderId, timestamp])
  @@map("order_tracking_events")
}

enum BroadcastStatus {
  PENDING
  ACCEPTED
  REJECTED
  MISSED
}

// Separate Table: Vendor Assignment Tracking (Broadcasts for 5km notifications & first-accept)
model OrderVendorBroadcast {
  id           BigInt          @id @default(autoincrement())
  orderId      BigInt
  vendorId     BigInt // Tracks each vendor notified for this order
  notifiedAt   DateTime        @default(now()) // When notification sent to this vendor
  acceptedAt   DateTime? // Non-null for the first acceptor (winner); sets order.vendorId
  rejectedAt   DateTime? // Set for non-winners after assignment (auto-reject)
  rejectReason String? // e.g., "Other vendor accepted first"
  status       BroadcastStatus @default(PENDING)
  // Relations
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor       Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([orderId, vendorId]) // One entry per vendor per order
  // Indexes (for quick winner lookup & timeouts)
  @@index([orderId])
  @@index([vendorId])
  @@index([acceptedAt]) // Query for winner: where acceptedAt is not null, ordered by asc (first)
  @@index([notifiedAt]) // For timeout jobs (e.g., expire after 2min if no accept)
  @@map("order_vendor_broadcasts")
}

// Separate Table: Delivery Partner Assignment Tracking (Broadcasts for 5km of vendor)
model OrderDeliveryBroadcast {
  id                BigInt          @id @default(autoincrement())
  orderId           BigInt
  deliveryPartnerId BigInt // Tracks each partner notified for this order
  notifiedAt        DateTime        @default(now()) // When notification sent to this partner
  acceptedAt        DateTime? // Non-null for the first acceptor (winner); sets order_delivery.deliveryPartnerId
  rejectedAt        DateTime? // Set for non-winners after assignment
  rejectReason      String? // e.g., "Other partner accepted first"
  status            BroadcastStatus @default(PENDING)
  // Relations
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([orderId, deliveryPartnerId])
  // Indexes
  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([acceptedAt]) // Query for winner
  @@index([notifiedAt]) // For timeout jobs
  @@map("order_delivery_broadcasts")
}

model OrderVendorAssignment {
  id         BigInt                 @id @default(autoincrement())
  orderId    BigInt                 @unique
  amount     Decimal                @db.Decimal(10, 2)
  vendorId   BigInt?
  assignedAt DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  status     VendorAssignmentStatus @default(PENDING)

  // For analytics and verification
  estimatedPrepTimeMinutes Int? // Time vendor needs to prepare
  actualPrepTimeMinutes    Int?

  pickupOtp String? // Optional if vendors use OTP verification
  notes     String? // Extra remarks (like unavailable item etc.)

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([vendorId, status])
  @@map("order_vendor_assignments")
}

enum VendorAssignmentStatus {
  PENDING // Broadcasted but not responded
  ACCEPTED // Vendor accepted order
  REJECTED // Vendor rejected order
  CANCELLED // Cancelled by system or user
  FAILED // Failed due to timeout / other issue
}

// Order Delivery (Links to assigned partner from broadcast)
model OrderDeliveryAssignment {
  id                BigInt  @id @default(autoincrement())
  orderId           BigInt  @unique
  deliveryPartnerId BigInt?

  assignedAt         DateTime?
  pickupEtaMinutes   Int?
  deliveryEtaMinutes Int?
  plannedDistanceKm  Float?
  actualDistanceKm   Float?

  // 🚴 Payout related
  basePay         Decimal? @db.Decimal(10, 2)
  distancePay     Decimal? @db.Decimal(10, 2)
  incentivePay    Decimal? @db.Decimal(10, 2)
  tipAmount       Decimal? @db.Decimal(10, 2)
  totalPay        Decimal? @db.Decimal(10, 2)
  isBadWeather    Boolean? @default(false)
  isNight         Boolean? @default(false)
  payCurrency     String?  @default("INR")
  incentiveReason Json? // e.g., { reason: "Good service", amount: 100 }

  pickupOtp   String?
  deliveryOtp String?
  status      AssignmentStatus @default(PENDING)

  pickupLat Float?
  pickupLng Float?
  dropLat   Float?
  dropLng   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([deliveryPartnerId, status])
  @@map("order_assignments")
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
  FAILED
}

// Note: App logic: On order placement, query vendors within 5km of user lat/long (Haversine formula), create OrderVendorBroadcast for each, send FCM notifications. Use transactions/locking to handle first-accept (e.g., check/update acceptedAt atomically). On vendor accept, set order.vendorId, notify others to reject, update status to VENDOR_ACCEPTED. Similarly for delivery broadcasts post-vendor assignment (5km from vendor location). Timeouts: If no accept in X minutes, cancel/refund and notify next batch or fail.

enum Status {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum PayoutStatus {
  PENDING
  SUCCESS
  REJECTED
  FAILED
  REFUNDED
}

model Vendor {
  id          BigInt  @id @default(autoincrement())
  ownerName   String?
  companyName String? // Optional, as it's now shop-specific
  email       String? @unique
  mobile      String  @unique // Unique per registration (phone)
  signature   Json?

  isActive     Boolean      @default(true)
  status       VendorStatus @default(NEW)
  rejectReason String?
  blockReason  String?

  isApproved Boolean @default(false)

  // Merged Shop fields (one Vendor = one shop now)
  shopName        String?
  mainAddress     String?
  completeAddress String?
  contactNumber   String? @unique
  floor           String?
  latitude        Float?
  longitude       Float?
  pincode         String?
  city            String? @default("Ranchi")
  state           String? @default("Jharkhan")
  country         String? @default("India")
  isOpen          Boolean @default(false)
  images          Json?
  fcmToken        String?

  documents     VendorDocument? // One-to-one
  bankAccounts  VendorBankAccount[]
  payouts       VendorPayout[]
  VendorProduct VendorProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  VendorWallet           VendorWallet? // One-to-one
  Notification           Notification[]
  CentralizedReview      CentralizedReview[]
  // OrderDelivery        OrderAssingnment[]
  OrderVendorBroadcast   OrderVendorBroadcast[]
  orderVendorAssignments OrderVendorAssignment[]
  payments               Payment[]
  vendorCategories       VendorCategory[]
  supportTickets         SupportTicket[]

  @@index([mobile])
  @@index([status, isApproved]) // For approval queries
  @@index([latitude, longitude]) // For 5km radius
  @@map("vendors")
}

enum VendorStatus {
  NEW // when created
  PROFILE_COMPLETION_NOT_FILLED //  when profile 
  DOCUMENTS_NOT_VERIFIED //  when Profile details will be filled then this will be marked
  SHOP_DETAILS_NOT_FILLED //  when all documents will be verified then it will marked this 
  SHOP_IMAGES_NOT_UPLOADED // when shop details filled then this will be marked
  PRODUCT_SELECTION_NOT_DONE // when shop image will be uploaded then this will be marked
  BANK_ACCOUNT_NOT_ADDED // when product selection will be done then this will be marked
  SIGNATURE_NOT_UPLOADED // when shop image will be uploaded then this will be marked
  PENDING // when shop image will be uploaded then this will be marked
  APPROVED // when vendor will approve then also then create a wallet for vendor
  REJECTED // in case admin reject with reject reason
  BLOCKED // in case of admin block with reason
}

model VendorWallet {
